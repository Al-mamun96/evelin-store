# Evelin — environment configuration
# Copy to .env.local for local development:  cp .env.example .env.local
# Next.js loads .env.local automatically. Never commit .env.local.
#
# Generate secrets with:  openssl rand -hex 32

# ---------------------------------------------------------------------------
# Public site origin
# ---------------------------------------------------------------------------
# The exact public origin of the storefront. Used for origin checks on every
# mutating request. In production this must match your domain exactly,
# including https:// and without a trailing slash:
#   NEXT_PUBLIC_SITE_URL=https://your-evelin-domain
# Leave unset locally; it then falls back to the incoming request origin.
NEXT_PUBLIC_SITE_URL=

# ---------------------------------------------------------------------------
# Admin access (required — admin login is disabled without both)
# ---------------------------------------------------------------------------
# Must be at least 16 characters. Compared in constant time.
ADMIN_PASSWORD=

# Must be at least 32 characters. Signs the admin session cookie.
# Rotating this signs out all admin sessions. Keep it backed up.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Courier credential encryption
# ---------------------------------------------------------------------------
# Encrypts the Steadfast API key and secret key at rest with AES-256-GCM.
# Strongly recommended as a separate, stable 32+ character secret so that
# rotating SESSION_SECRET does not invalidate saved courier settings.
# Falls back to SESSION_SECRET when unset.
#
# If this value changes or is lost, saved courier keys become unreadable and
# both keys must be re-entered in the admin Steadfast screen. Keep a secure
# backup somewhere other than the VPS.
SETTINGS_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# SQLite database path. Uploaded product photos are stored in an `uploads/`
# folder in the same directory, so this directory is your live store data —
# back it up and mount it as a persistent volume in Docker.
# Local:   ./data/evelin.sqlite
# Docker:  /app/data/evelin.sqlite
DATABASE_PATH=./data/evelin.sqlite

# Destination for `npm run db:backup`. Defaults to ./backups.
# In the container, /app/backups should be a persistent volume.
# Backups contain customer data and encrypted courier credentials:
# restrict access and copy them off the server.
# BACKUP_PATH=./backups

# ---------------------------------------------------------------------------
# Store availability
# ---------------------------------------------------------------------------
# true accepts customer checkout orders. Set to false during setup.
# After the first admin settings save, the open/paused switch in
# Store settings takes precedence and this variable alone no longer
# overrides it.
STORE_LIVE=false

# ---------------------------------------------------------------------------
# Local development only
# ---------------------------------------------------------------------------
# The admin session cookie is marked Secure by default, so browsers will
# refuse to send it over plain http://localhost. Set this to true ONLY while
# developing on local HTTP.
#
# WARNING: never set this to true on the public VPS. It allows the admin
# session cookie to be sent over unencrypted connections.
INSECURE_LOCAL_COOKIES=true
# ---------------------------------------------------------------------------
# Telegram order notifications (optional)
# ---------------------------------------------------------------------------
# Create a bot with @BotFather, add it to the destination chat, and set the
# chat ID. Confirmed orders are sent to this chat from the admin workflow.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SEO: evelinbd.site is indexable by default even while orders are paused.
# Other origins retain the store open/paused fallback when this is blank.
# Set true after launch to keep catalog pages indexable during order pauses.
# Set false to noindex a staging site. Requires a valid NEXT_PUBLIC_SITE_URL.
SEO_INDEXABLE=
# Optional public verification tokens (not API keys); do not paste full HTML tags.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=